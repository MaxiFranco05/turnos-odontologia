# ==============================================================================
# Variables de Entorno de Producción - Turnos Odontología
# Referencia: knowledge-base/08_arquitectura_propuesta.md & C-17 docker-compose-prod
# REGLA DURA #12: Usar valores sintéticos en plantillas; nunca commitear secretos reales.
# ==============================================================================

# Entorno y configuración del servidor API
APP_ENV=production
APP_NAME="Turnos Odontología API"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Base de datos PostgreSQL (acceso interno entre contenedores en la red interna)
# Formato: postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
POSTGRES_DB=turnos_odontologia_prod
POSTGRES_USER=turnos_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://turnos_user:CHANGE_THIS_IN_PRODUCTION_STRONG_PASSWORD@postgres:5432/turnos_odontologia_prod

# Seguridad y Autenticación JWT (firma criptográfica HMAC-SHA256)
# IMPORTANTE: Reemplazar por una clave aleatoria de al menos 32 caracteres criptográficamente segura
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_SECURE_RANDOM_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Reglas de Negocio Clínico (knowledge-base/05_reglas_de_negocio.md)
CANCEL_MIN_HOURS=24
TIMEZONE=America/Argentina/Buenos_Aires
