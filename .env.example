# ==============================================================================
# Variables de Entorno - Turnos Odontología (turnos-odontologia)
# Referencia: knowledge-base/08_arquitectura_propuesta.md
# ==============================================================================

# Entorno de ejecución (development | testing | production)
APP_ENV=development
APP_NAME="Turnos Odontología API"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Base de datos PostgreSQL (SQLAlchemy 2.0 asincrónico vía asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/turnos_odontologia
POSTGRES_DB=turnos_odontologia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Seguridad y Autenticación JWT
JWT_SECRET=supersecretkey_change_in_production_min_32_chars_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Reglas de Negocio (knowledge-base/05_reglas_de_negocio.md)
CANCEL_MIN_HOURS=24
TIMEZONE=America/Argentina/Buenos_Aires
